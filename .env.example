# ==========================================
# Neon Serverless PostgreSQL Database
# ==========================================
# Pooled connection string (used at runtime by the serverless application)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct unpooled connection string (used for direct migrations with Drizzle Kit)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================
# Resend Email Integration (Optional)
# ==========================================
# If configured, contact form submissions will trigger email notifications
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Destination email where contact submissions should be forwarded
CONTACT_EMAIL=yassa.ashraf.albir@gmail.com

# ==========================================
# Application Configuration
# ==========================================
NEXT_PUBLIC_SITE_URL=https://yassa-portfolio.vercel.app
